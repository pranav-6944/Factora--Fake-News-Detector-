# FacTora Environment Variables
# Copy this file to .env and fill in your values

# Flask secret key (generate a random string for production)
SECRET_KEY=your-flask-secret-key-here

# NewsAPI.org API key (get one at https://newsapi.org)
NEWS_API_KEY=your-newsapi-org-key-here

# HuggingFace model repo (default: pranav6944/factora-bert)
# HF_MODEL_REPO=pranav6944/factora-bert

# Flask debug mode (set to false in production)
# FLASK_DEBUG=false

# Port (Render sets this automatically)
# PORT=5000
